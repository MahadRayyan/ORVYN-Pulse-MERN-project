PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/orvyn_pulse
APP_URL=http://localhost:5173
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters
META_APP_ID=
META_APP_SECRET=
# Optional configuration ID when your Meta app uses Facebook Login for Business.
META_LOGIN_CONFIG_ID=
META_API_VERSION=v25.0
META_REDIRECT_URI=http://localhost:4000/api/meta/callback
META_SCOPES=pages_show_list,pages_read_engagement,read_insights,instagram_basic,instagram_manage_insights,instagram_manage_comments
SYNC_INTERVAL_MINUTES=60
# Optional Facebook REACH metric supported by your chosen Graph version.
# Leave blank if unavailable; views must never be substituted for reach.
META_FB_REACH_METRIC=
